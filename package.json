{
  "name": "finance-tracker",
  "private": true,
  "scripts": {
    "test:companion": "node tests/companion.mjs",
    "test:expense-edit": "node tests/expense-edit.mjs",
    "test:expense-edit-browser": "node tests/expense-edit-browser.cjs",
    "test:companion-browser": "node tests/companion-browser.cjs",
    "start": "python server.py",
    "test": "python -m unittest discover -s tests -v",
    "test:browser": "node tests/browser.cjs",
    "test:parity": "node tests/parity.mjs",
    "test:worker": "node tests/worker.mjs",
    "cf:dev": "wrangler dev --local",
    "cf:check": "wrangler deploy --dry-run",
    "cf:deploy": "wrangler deploy",
    "test:client": "node tests/api-client.cjs",
    "test:parser": "node tests/expense-parser.cjs",
    "test:analytics": "node tests/analytics.cjs && node tests/analytics-core.cjs",
    "test:merchants": "node tests/merchants.cjs",
    "test:merchants:browser": "node tests/merchant-browser.cjs",
    "test:categories": "node tests/category-utils.cjs",
    "test:edge": "node tests/edge-cases.cjs && node tests/batch-edge.mjs",
    "format": "prettier --write web cloudflare tests/*.mjs tests/*.cjs package.json",
    "format:check": "prettier --check web cloudflare tests/*.mjs tests/*.cjs package.json",
    "test:analytics-browser": "node tests/analytics-browser.cjs"
  },
  "devDependencies": {
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "wrangler": "^4.156.0"
  }
}
