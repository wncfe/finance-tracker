<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#183F36</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="QuickTheme" parent="android:style/Theme.Material.Light.Dialog.NoActionBar">
        <item name="android:windowMinWidthMajor">92%</item>
        <item name="android:windowMinWidthMinor">92%</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorAccent">#183F36</item>
    </style>
</resources>
